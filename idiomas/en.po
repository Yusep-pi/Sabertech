msgstr "WASD: walk · Mouse: look · E or click: use · Hold E: doors · F: eat · Esc: release mouse"

msgid "Objetivo: revisá la misión en la computadora de misión."
msgstr "Objective: review the mission on the mission computer."

msgid "Objetivo: diseñá la nave y lanzala desde la computadora de misión."
msgstr "Objective: design the spacecraft and launch it from the mission computer."

msgid "Misión terminada: el informe está en cualquier consola."
msgstr "Mission complete: the report is on any console."

msgid "Objetivo: llegá a la Luna con la tripulación entera (tramo %d de %d)."
msgstr "Objective: reach the Moon with the whole crew (leg %d of %d)."

msgid "Objetivo: operá la nave (turno %d de %d). Cualquier consola sirve."
msgstr "Objective: operate the spacecraft (turn %d of %d). Any console will do."

msgid "Saliste por la escotilla. Arreglá los %d problemas y volvé antes de quedarte sin oxígeno."
msgstr "You're out the hatch. Fix the %d problems and get back before you run out of oxygen."

msgid "Escotilla · oxígeno y combustible"
msgstr "Hatch · oxygen and propellant"

msgid "☄ Micrometeoritos"
msgstr "☄ Micrometeoroids"

msgid "¡Funciona! Volvé a la escotilla."
msgstr "It works! Head back to the hatch."

msgid "¡Funciona! Quedan %d problemas."
msgstr "It works! %d problems left."

msgid "Pasó la lluvia de micrometeoritos."
msgstr "The micrometeoroid shower has passed."

msgid "¡Golpe a %.1f m/s! El traje se dañó. Frená con X antes de llegar."
msgstr "Impact at %.1f m/s! Your spacesuit was damaged. Brake with X before you arrive."

msgid "Te quedaste sin oxígeno."
msgstr "You ran out of oxygen."

msgid "El traje no resistió más daño."
msgstr "Your spacesuit couldn't take any more damage."

msgid "Quedaste a la deriva, sin combustible para volver."
msgstr "You're adrift, with no propellant to get back."

msgid "Todos los problemas resueltos y de vuelta en la nave."
msgstr "All problems fixed and back aboard the spacecraft."

msgid "Llevás %d minutos afuera. El silencio empieza a pesar: la cordura baja."
msgstr "You've been outside for %d minutes. The silence is starting to weigh on you: sanity is dropping."

msgid "Demasiado tiempo solo en el vacío. Volvé a la nave antes de perder la cabeza."
msgstr "Too long alone in the void. Get back to the ship before you lose your mind."

msgid "¡Caminata completada!"
msgstr "Spacewalk complete!"

msgid "Caminata fallida"
msgstr "Spacewalk failed"

msgid "Tiempo afuera: %d:%02d · Oxígeno restante: %d s · Traje: %d%% · Problemas resueltos: %d de %d"
msgstr "Time outside: %d:%02d · Oxygen left: %d s · Suit: %d%% · Problems fixed: %d of %d"

msgid "Volver a la esclusa"
msgstr "Back to the airlock"

msgid "Reintentar desde la esclusa"
msgstr "Retry from the airlock"

msgid "Repetir la caminata"
msgstr "Repeat the spacewalk"

msgid "WASD: propulsar · Espacio/Ctrl: subir/bajar · Shift: turbo · X: frenar · Z/C: rotar · E: abrir panel · Esc: soltar el panel o el mouse"
msgstr "WASD: thrust · Space/Ctrl: up/down · Shift: boost · X: brake · Z/C: roll · E: open panel · Esc: leave the panel or release the mouse"

